# =============================================================================
# ISBAR CSMS — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/csms
PGUSER=postgres
PGHOST=localhost
PGDATABASE=csms
PGPASSWORD=your_password
PGPORT=5432

# ── Frontend API routing ───────────────────────────────────────────────────────
VITE_API_BASE=/isbar/api

# =============================================================================
# AI PROVIDERS
# =============================================================================
# The system tries each ENABLED provider top-to-bottom.
# First healthy provider wins. On failure, the next is tried automatically.
#
# Priority order (as configured in aiProviders.js):
#   Local (free, private) → Free Cloud → Paid Cloud
#
# You only need ONE provider to have AI features working.
# Add more for redundancy / cost control.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL AI PROVIDERS — run on your machine, free, private, no internet needed
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama ────────────────────────────────────────────────────────────────────
# Best local option. Easy install, large model library.
#
# SETUP:
#   1. Install:  https://ollama.com  (or: winget install Ollama.Ollama)
#   2. Start:    ollama serve         (runs on port 11434)
#   3. Pull model: ollama pull llama3.2
#   4. Set OLLAMA_ENABLED=true below
#
# RECOMMENDED MODELS (clinical use):
#   llama3.2       — fast, good quality (2GB)
#   llama3.1:8b    — better quality, still fast (4.7GB)
#   mistral        — excellent instruction following (4GB)
#   phi4           — Microsoft's small but capable model (9GB)
#   gemma3:4b      — Google's efficient model (3GB)
#   medllama3      — medical fine-tune (if available on your system)
#
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── LM Studio ─────────────────────────────────────────────────────────────────
# GUI app for running local models. OpenAI-compatible API.
#
# SETUP:
#   1. Install:  https://lmstudio.ai
#   2. Open LM Studio → Download a model
#   3. Go to "Local Server" tab → Start Server
#   4. Set LMSTUDIO_ENABLED=true below
#   5. Set LMSTUDIO_MODEL to the model you loaded
#
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=local-model

# ── Jan AI ─────────────────────────────────────────────────────────────────────
# Alternative to LM Studio. Simple UI, OpenAI-compatible API.
#
# SETUP:
#   1. Install:  https://jan.ai
#   2. Download a model inside the app
#   3. Settings → Local API Server → Start
#   4. Set JANAI_ENABLED=true below
#
JANAI_ENABLED=false
JANAI_BASE_URL=http://localhost:1337
JANAI_MODEL=mistral-ins-7b-q4

# ── llama.cpp server ──────────────────────────────────────────────────────────
# Bare-metal local inference. Fastest option for advanced users.
#
# SETUP:
#   1. Build:  https://github.com/ggerganov/llama.cpp
#   2. Start:  ./server -m your-model.gguf --port 8080 --ctx-size 4096
#   3. Set LLAMACPP_ENABLED=true below
#
LLAMACPP_ENABLED=false
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_MODEL=default

# ─────────────────────────────────────────────────────────────────────────────
# FREE CLOUD AI PROVIDERS — require a free API key, use the internet
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Generous free tier. No credit card required.
#
# SETUP:
#   1. Go to: https://aistudio.google.com/app/apikey
#   2. Create a key (free, instant)
#   3. Paste it below
#
# The system automatically tries Flash → Pro → Lite as fallbacks.
#
GEMINI_API_KEY=

# ── Groq ──────────────────────────────────────────────────────────────────────
# Fastest cloud inference (runs on custom LPU chips). Very generous free tier.
# Great for real-time streaming responses.
#
# SETUP:
#   1. Go to: https://console.groq.com
#   2. Sign up (free) → API Keys → Create Key
#   3. Paste key below
#
# RECOMMENDED MODELS:
#   llama-3.3-70b-versatile   — best quality
#   llama-3.1-8b-instant      — fastest
#   mixtral-8x7b-32768        — long context
#   gemma2-9b-it              — efficient
#
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────────────────────────────────────
# PAID CLOUD AI PROVIDERS — best quality, pay per token
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ────────────────────────────────────────────────────────────────────
# SETUP:
#   1. Go to: https://platform.openai.com/api-keys
#   2. Create a key (requires account + billing)
#   3. Paste key below
#
# RECOMMENDED MODELS:
#   gpt-4o-mini   — best cost/quality ratio (default)
#   gpt-4o        — highest quality
#   gpt-3.5-turbo — cheapest
#
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Mistral AI ────────────────────────────────────────────────────────────────
# European provider — good for GDPR compliance. Free trial available.
#
# SETUP:
#   1. Go to: https://console.mistral.ai
#   2. Sign up → API Keys → Create Key
#   3. Paste key below
#
# RECOMMENDED MODELS:
#   mistral-small-latest   — fast and affordable (default)
#   mistral-large-latest   — highest quality
#   open-mistral-7b        — cheapest
#
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# =============================================================================
# ADDING A CUSTOM PROVIDER
# =============================================================================
# Any OpenAI-compatible API can be added in 3 steps:
#
# 1. Add env vars here:
#    MY_PROVIDER_API_KEY=your-key
#    MY_PROVIDER_BASE_URL=https://api.example.com
#    MY_PROVIDER_MODEL=my-model-name
#
# 2. Add one entry in backend/src/features/ai/aiProviders.js:
#    {
#      id:      'my-provider',
#      label:   'My Provider',
#      enabled: () => !!process.env.MY_PROVIDER_API_KEY,
#      call: (msgs, sys, opts) => callOpenAICompat(
#        process.env.MY_PROVIDER_BASE_URL,
#        process.env.MY_PROVIDER_MODEL,
#        process.env.MY_PROVIDER_API_KEY,
#        [{ role: 'system', content: sys }, ...msgs],
#        opts,
#      ),
#    },
#
# 3. Restart the server. Done.
# =============================================================================
