# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/isbar_db

# ── AI Provider (at least one required) ───────────
# OpenAI / compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Groq (fast, free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GEMINI_API_KEY=

# ── Service ───────────────────────────────────────
PORT=8000
HOST=0.0.0.0
